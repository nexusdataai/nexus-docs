# NexusAI Docs deploy configuration.
# Copy this file to `.env.local` (gitignored) and fill in the values you control.
# After running setup-website.sh, the script will append DOCS_CLOUDFRONT_ID and
# DOCS_CLOUDFRONT_DOMAIN automatically.

# AWS profile name configured locally (aws configure --profile <name>).
AWS_PROFILE=external-access

# AWS region for the S3 bucket. CloudFront itself is global.
AWS_REGION=us-east-1

# Globally unique S3 bucket name for the static documentation site.
DOCS_S3_BUCKET=nexusai-docs

# Populated by setup-website.sh after CloudFront is created.
# DOCS_CLOUDFRONT_ID=
# DOCS_CLOUDFRONT_DOMAIN=
